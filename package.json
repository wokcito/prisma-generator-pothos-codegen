{
  "name": "@wokcito/prisma-generator-pothos-codegen",
  "version": "1.0.0",
  "author": "Maximiliano Kazanski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wokcito/prisma-generator-pothos-codegen.git"
  },
  "main": "./src/index.js",
  "module": "./src/index.js",
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@prisma/orm-postgres": "8.0.0-rc.11",
    "@types/node": "22.20.2",
    "prisma": "https://registry.npmjs.org/prisma/-/prisma-8.0.0-rc.15.tgz",
    "shx": "0.4.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "peerDependencies": {
    "@pothos/core": "^4.0.2",
    "@prisma/orm-postgres": "^8.0.0-rc.11"
  },
  "exports": {
    "import": "./src/index.js",
    "require": "./src/index.js"
  },
  "bin": {
    "prisma-generator-pothos-codegen": "./src/bin.js"
  },
  "description": "A prisma generator that generate input types for Pothos. And optionally generate all crud.",
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "pothos",
    "graphql",
    "typescript",
    "prisma",
    "db",
    "postgres",
    "codegen"
  ],
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "tscheck": "tsc -noEmit",
    "prebuild": "bun run clean",
    "postbuild": "shx cp ./README.md ./dist && shx chmod +x ./dist/src/bin.js",
    "clean": "shx rm -rf dist",
    "pub": "cd dist && npm publish",
    "format": "biome check --write ./src",
    "lint": "biome check ./src",
    "check-src-and-examples": "bun run lint && bun run test && bun run tscheck",
    "fullcheck": "bun run check-src-and-examples"
  },
  "types": "./src/index.d.ts"
}
